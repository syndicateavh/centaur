Options -MultiViews
DirectoryIndex index.html
DirectorySlash On

RewriteEngine On

# Send every production HTTP/www request directly to the canonical HTTPS host.
RewriteCond %{HTTP_HOST} ^(?:www\.)?centaurcareers\.in$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.centaurcareers\.in$ [NC]
RewriteRule ^ https://centaurcareers.in%{REQUEST_URI} [R=301,L,NE]

# Serve the branded document for missing URLs while preserving HTTP 404.
ErrorDocument 404 /404/index.html
