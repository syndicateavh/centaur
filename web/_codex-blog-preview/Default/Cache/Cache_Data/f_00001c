function createRoleIntent({
  id,
  kind,
  label,
  guideId,
  canonicalPath,
  primaryQuestion,
  searchQuestions,
  summary,
  quizDomainId,
  coursePath,
  coursePathLabel = 'Compare the course path',
  articleLinks = [],
}) {
  return Object.freeze({
    id,
    kind,
    label,
    guideId,
    canonicalPath,
    primaryQuestion,
    searchQuestions: Object.freeze(searchQuestions),
    summary,
    quizDomainId,
    coursePath,
    coursePathLabel,
    articleLinks: Object.freeze(articleLinks.map((article) => Object.freeze(article))),
  });
}

