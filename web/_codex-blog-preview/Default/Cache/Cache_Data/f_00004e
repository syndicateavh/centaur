.route-loading-screen {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: grid;
  place-items: center;
  overflow: hidden;
  isolation: isolate;
  background: #fff;
}

.route-loading-content {
  position: relative;
  z-index: 2;
  width: min(42rem, calc(100vw - 2rem));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transform-style: preserve-3d;
}

.route-loading-mark {
  position: relative;
  width: min(36rem, 94vw);
  height: clamp(15rem, 45vw, 21rem);
  display: grid;
  place-items: center;
  margin-bottom: 0.35rem;
  transform: translateZ(2.5rem);
}

.centaur-vfx-stage {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 2rem;
}

.centaur-sprite {
  position: absolute;
  z-index: 4;
  left: 50%;
  top: 50%;
  width: clamp(15rem, 46vw, 20rem);
  aspect-ratio: 1;
  animation: centaur-run-bob 760ms linear infinite;
  will-change: transform;
}

.centaur-sprite::before {
  content: '';
  position: absolute;
  inset: 7%;
  background-image: url('/images/loading/centaur-run-cycle-logo-style-clean.png');
  background-image: -webkit-image-set(url('/images/loading/centaur-run-cycle-logo-style-clean.webp') type('image/webp'), url('/images/loading/centaur-run-cycle-logo-style-clean.png') type('image/png'));
  background-image: image-set(url('/images/loading/centaur-run-cycle-logo-style-clean.webp') type('image/webp'), url('/images/loading/centaur-run-cycle-logo-style-clean.png') type('image/png'));
  background-position: 0 0;
  background-size: 400% 200%;
  background-repeat: no-repeat;
  animation: centaur-run-cycle 760ms linear infinite;
  will-change: background-position;
}

.route-loading-title {
  margin: 0;
  color: hsl(var(--primary));
  font-size: clamp(1.2rem, 4vw, 1.55rem);
  font-weight: 700;
  letter-spacing: 0.06em;
  transform: translateZ(1.5rem);
}

.route-loading-caption {
  margin: 0.35rem 0 1.2rem;
  color: hsl(var(--muted-foreground));
  font-size: 0.77rem;
  font-weight: 500;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.route-loading-track {
  width: min(13rem, 54vw);
  height: 2px;
  overflow: hidden;
  border-radius: 9999px;
  background: hsl(var(--muted));
}

.route-loading-track span {
  display: block;
  width: 38%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, transparent, #d4af37 35%, #fff2af 70%, transparent);
  filter: drop-shadow(0 0 0.35rem rgba(212, 175, 55, 0.9));
  animation: route-loading-progress 1.25s ease-in-out infinite;
}

@keyframes centaur-run-cycle {
  0%, 12.49% { background-position: 0% 0%; }
  12.5%, 24.99% { background-position: 33.333% 0%; }
  25%, 37.49% { background-position: 66.666% 0%; }
  37.5%, 49.99% { background-position: 100% 0%; }
  50%, 62.49% { background-position: 0% 100%; }
  62.5%, 74.99% { background-position: 33.333% 100%; }
  75%, 87.49% { background-position: 66.666% 100%; }
  87.5%, 100% { background-position: 100% 100%; }
}

@keyframes centaur-run-bob {
  0%, 50%, 100% { transform: translate(-50%, -49%); }
  25%, 75% { transform: translate(-50%, -53%); }
}

@keyframes route-loading-progress {
  from { transform: translateX(-110%); }
  to { transform: translateX(250%); }
}

@media (prefers-reduced-motion: reduce) {
  .centaur-sprite,
  .centaur-sprite::before,
  .route-loading-track span {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

@media (max-width: 480px) {
  .route-loading-mark {
    height: 14rem;
    margin-bottom: 0.4rem;
  }

  .centaur-vfx-stage {
    border-radius: 1rem;
  }

  .centaur-sprite {
    left: 50%;
    top: 46%;
    width: 14.5rem;
  }

  .route-loading-caption {
    font-size: 0.67rem;
    letter-spacing: 0.1em;
  }
}

