import { BLOG_BLOCK_TYPES } from "/src/content/blog/blogSchema.js";

const paragraph = (text) => ({ type: BLOG_BLOCK_TYPES.PARAGRAPH, text });
const heading = (text) => ({ type: BLOG_BLOCK_TYPES.HEADING, level: 2, text });
const list = (items, ordered = false) => ({ type: BLOG_BLOCK_TYPES.LIST, ordered, items });
const link = (label, href, routeId) => ({ type: BLOG_BLOCK_TYPES.LINK, label, href, routeId });
const faq = (question, answer) => ({ type: BLOG_BLOCK_TYPES.FAQ, question, answer });

function leadPage({
  id,
  path,
  title,
  description,
  h1,
  breadcrumbLabel,
  primaryKeyword,
  secondaryKeywords,
  opening,
  intentHeading,
  intentAnswer,
  criteria,
  decisionProcess,
  centaurFit,
  extraBlocks = [],
  questions,
  links,
  sources = [],
  faqs,
  parentId = 'home',
  updatedAt = '2026-09-29',
}) {
  return Object.freeze({
    id,
    routeId: id,
    parentId,
    path,
    title,
    description,
    h1,
    breadcrumbLabel,
    primaryKeyword,
    secondaryKeywords: Object.freeze(secondaryKeywords),
    updatedAt,
    body: Object.freeze([
      paragraph(opening),
      heading(intentHeading),
      paragraph(intentAnswer),
      heading('What to compare before enrolling'),
      list(criteria),
      heading('A practical decision process'),
      paragraph(decisionProcess),
      ...extraBlocks,
      heading('Where Centaur Careers fits this search'),
      paragraph(centaurFit),
      heading('Questions to ask before payment'),
      list(questions, true),
      heading('Continue your research'),
      ...links.map(({ label, href, routeId }) => link(label, href, routeId)),
      ...(sources.length ? [
        heading('Program pages reviewed'),
        paragraph('These official pages show how course focus, practical work, delivery and credential differ. Provider details and admissions can change, so confirm current terms directly.'),
        ...sources.map(({ label, href }) => link(label, href)),
      ] : []),
      heading('Common questions'),
      ...faqs.map(({ question, answer }) => faq(question, answer)),
    ]),
    relatedRouteIds: Object.freeze(links.map(({ routeId }) => routeId)),
  });
}

