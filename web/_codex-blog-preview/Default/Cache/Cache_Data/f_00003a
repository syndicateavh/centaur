    id,
    routeId,
    path,
    title,
    description,
    h1,
    breadcrumbLabel,
    primaryKeyword,
    secondaryKeywords: Object.freeze(secondaryKeywords),
    body: Object.freeze([...body, ...(GUIDE_DEPTH_ADDITIONS[id] || []), ...getJobIntentDepthBlocks(id)]),
    author: GUIDE_AUTHOR,
    publishedAt: GUIDE_DATE,
    updatedAt: JOB_INTENT_GUIDE_IDS.includes(id) ? JOB_INTENT_REVIEW_DATE : updatedAt,
    relatedGuideIds: Object.freeze(relatedGuideIds),
    relatedRouteIds: Object.freeze(relatedRouteIds),
