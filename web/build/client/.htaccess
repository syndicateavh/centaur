Options -MultiViews
DirectoryIndex index.html
DirectorySlash On

# Public static resources must never depend on a Referer header.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(?:css|js|mjs|map|jpg|jpeg|png|webp|avif|svg|ico|woff|woff2)$">
    Require all granted
  </FilesMatch>
</IfModule>

# Keep modern image formats from being returned as text/plain by the host.
# X-Content-Type-Options: nosniff is enabled below, so the browser must receive
# the correct media type in order to use these sources.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/assets/" immutable_asset=1
  SetEnvIf Request_URI "^/images/" public_image=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
  Header set Cache-Control "public, max-age=604800" env=public_image
</IfModule>

RewriteEngine On

# Permanently forward the previous city-page URLs to their new SEO slugs.
RewriteRule ^india/delhi-ncr/?$ https://centaurcareers.in/best-finance-course-in-delhi/ [R=301,L,NE]
RewriteRule ^india/bengaluru/?$ https://centaurcareers.in/best-finance-course-in-bangalore/ [R=301,L,NE]
RewriteRule ^india/mumbai/?$ https://centaurcareers.in/best-finance-course-in-mumbai/ [R=301,L,NE]
RewriteRule ^india/pune/?$ https://centaurcareers.in/best-finance-course-in-pune/ [R=301,L,NE]
RewriteRule ^india/hyderabad/?$ https://centaurcareers.in/best-finance-course-in-hyderabad/ [R=301,L,NE]
RewriteRule ^locations/lucknow/?$ https://centaurcareers.in/best-finance-course-in-lucknow/ [R=301,L,NE]

# Retire the former article slug without creating a duplicate content URL.
RewriteRule ^blog/placement-guarantee-eligibility-and-terms/?$ https://centaurcareers.in/blog/placement-support-eligibility-and-terms/ [R=301,L,NE]

# Preserve visits and links to the former program landing page.
RewriteRule ^financial-operations-masterclass/?$ https://centaurcareers.in/courses/ [R=301,L,NE]

# Normalize public document URLs to HTTPS, the canonical host, and trailing
# slashes in one redirect. File-like assets remain unchanged.
RewriteCond %{HTTP_HOST} ^(?:www\.)?centaurcareers\.in$ [NC]
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[^/]+$ [NC]
RewriteRule ^ https://centaurcareers.in%{REQUEST_URI}/ [R=301,L,NE]

# Send every production HTTP/www request directly to the canonical HTTPS host.
RewriteCond %{HTTP_HOST} ^(?:www\.)?centaurcareers\.in$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.centaurcareers\.in$ [NC]
RewriteRule ^ https://centaurcareers.in%{REQUEST_URI} [R=301,L,NE]

# Serve the branded document for missing URLs while preserving HTTP 404.
ErrorDocument 404 /404/index.html
