Options -MultiViews
DirectoryIndex index.html
DirectorySlash On

# Public static resources must never depend on a Referer header.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(?:css|js|mjs|map|jpg|jpeg|png|webp|avif|svg|ico|woff|woff2)$">
    Require all granted
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/assets/" immutable_asset=1
  SetEnvIf Request_URI "^/images/" public_image=1
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=31536000, immutable" env=immutable_asset
  Header set Cache-Control "public, max-age=604800" env=public_image
</IfModule>

RewriteEngine On

# Send every production HTTP/www request directly to the canonical HTTPS host.
RewriteCond %{HTTP_HOST} ^(?:www\.)?centaurcareers\.in$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.centaurcareers\.in$ [NC]
RewriteRule ^ https://centaurcareers.in%{REQUEST_URI} [R=301,L,NE]

# Serve the branded document for missing URLs while preserving HTTP 404.
ErrorDocument 404 /404/index.html
