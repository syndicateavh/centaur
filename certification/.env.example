# Copy this file to .env for local development. Values here are local-only.
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api/v1
LOG_LEVEL=debug
SESSION_TTL_SECONDS=2592000
TRUST_PROXY_HOPS=0
DATABASE_POOL_MAX=10

DATABASE_URL=postgresql://centaur_lms:centaur_lms_local_only@localhost:55432/centaur_lms
REDIS_URL=redis://localhost:6379

# Configure a private Cloudflare R2 bucket before enabling media uploads/playback.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_MAX_UPLOAD_BYTES=5368709120
MEDIA_UPLOAD_PART_BYTES=16777216
MEDIA_SIGNED_URL_TTL_SECONDS=3600
MEDIA_MAX_DURATION_SECONDS=14400
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
