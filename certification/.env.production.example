# Copy to .env.production on the deployment host; never commit the populated file.
POSTGRES_DB=centaur_lms
POSTGRES_USER=centaur_lms
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHAR_SECRET
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHAR_SECRET

NODE_ENV=production
LOG_LEVEL=info
API_PUBLIC_URL=https://academy.example.com
WEB_ORIGIN=https://academy.example.com
VITE_API_BASE_URL=https://academy.example.com/api/v1
WEB_BIND_PORT=8080
# Trust exactly the reverse proxy hops between the browser and Nest API.
TRUST_PROXY_HOPS=2
SESSION_TTL_SECONDS=2592000
DATABASE_POOL_MAX=10
DATABASE_URL=postgresql://centaur_lms:REPLACE_WITH_64_HEX_CHAR_SECRET@postgres:5432/centaur_lms?sslmode=disable
REDIS_URL=redis://:REPLACE_WITH_DIFFERENT_64_HEX_CHAR_SECRET@redis:6379/0

R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=centaur-lms-private
R2_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_SECRET
MEDIA_MAX_UPLOAD_BYTES=1073741824
MEDIA_UPLOAD_PART_BYTES=16777216
MEDIA_SIGNED_URL_TTL_SECONDS=3600
MEDIA_MAX_DURATION_SECONDS=14400
