# Copy this file to .env for local development. Values below are local-only.
NODE_ENV=development
APP_PORT=3000
LMS_PUBLIC_URL=http://localhost:3000
POSTGRES_DB=centaur_lms
LMS_APP_USER=lms_app
LMS_APP_PASSWORD=local_app_only
DATABASE_URL=postgresql://lms_app:local_app_only@127.0.0.1:54322/centaur_lms
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-only-secret-change-before-any-deployment-32chars-min
LMS_AUTH_ENABLED=false
LMS_CONTROLLED_PILOT=false
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
LMS_SCHEDULER_ACTOR_USER_ID=
